{
  "name": "pipoca-greeter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "pipoca": {
    "id": "greeter",
    "title": "Greeter",
    "description": "Greets you on its own page and with /greet in a Session.",
    "engine": 1,
    "capabilities": [
      "routes"
    ],
    "parts": {
      "server": "server.ts",
      "web": "web.tsx",
      "session": "session.ts"
    },
    "settings": {
      "greeting": {
        "type": "string",
        "title": "Greeting",
        "default": "Hello"
      }
    }
  }
}
