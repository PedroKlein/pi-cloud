{
  "name": "pi-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "pi-extensions/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/pi-cloud build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "prettier": "3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
